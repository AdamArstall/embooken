{
    "type": "module",
    "scripts": {
        "dev": "extension dev",
        "dev-ff": "extension dev --browser=firefox --firefox-binary $HOME/.local/bin/firefox-dev",
        "build": "extension build --browser firefox,chrome",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "epubcheck:install": "node scripts/get-epubcheck.mjs",
        "validate": "npm run epubcheck:install && vitest run --config vitest.epubcheck.config.ts"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "addons-linter": "^10.13.0",
        "extension": "^4.1.38",
        "jsdom": "^30.1.3",
        "prettier": "3.9.6",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "fflate": "^0.8.3"
    },
    "allowScripts": {
        "fsevents@2.3.3": true
    }
}
